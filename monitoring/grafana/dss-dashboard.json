{
  "uid": "dss-api",
  "title": "Digital Social Score : API de toxicité",
  "tags": [
    "dss",
    "gmp"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Chiffres clés",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes / seconde",
      "description": "Charge reçue par /score",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m]))",
          "legendFormat": "Requêtes / seconde"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latence P95",
      "description": "95 % des requêtes /score vont plus vite que ça. Orange > 300 ms (SLO), rouge > 500 ms (alerte)",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "Latence P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latence P99",
      "description": "99 % des requêtes /score vont plus vite que ça : les pires cas",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "Latence P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Temps d'inférence (P95)",
      "description": "Durée du calcul seul : anonymisation, nettoyage et LSTM. Orange > 50 ms, rouge > 100 ms",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dss_inference_latency_seconds_bucket{job=\"dss-api\"}[2m])))",
          "legendFormat": "Temps d'inférence (P95)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erreurs 5xx",
      "description": "Part des réponses /score en erreur serveur. Rouge > 1 %",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\",status=\"5xx\"}[2m])) / sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m])) or vector(0)",
          "legendFormat": "Erreurs 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Pods qui répondent",
      "description": "Pods de l'API collectés par Prometheus (ajoutés par le HPA sous charge)",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "count(up{job=\"dss-api\"} == 1) or vector(0)",
          "legendFormat": "Pods qui répondent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Courbes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latence HTTP (P95, P99) et temps d'inférence",
      "description": "Si la latence HTTP monte alors que l'inférence reste basse, le temps est perdu en file d'attente (pods saturés), pas dans le modèle",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "HTTP P95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "HTTP P99"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(dss_inference_latency_seconds_bucket{job=\"dss-api\"}[2m])))",
          "legendFormat": "Inférence P95 ({{model}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requêtes / seconde par code de réponse",
      "description": "200 = succès, 429 = limite de requêtes, 5xx = erreur serveur",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (status) (rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU par pod et nombre de pods",
      "description": "CPU utilisé / CPU demandé (100 % = ce que le pod a demandé). Le HPA ajoute des pods quand la moyenne dépasse 50 %",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "max by (pod_name) (kubernetes_io:container_cpu_request_utilization{monitored_resource=\"k8s_container\",namespace_name=\"default\",container_name=\"api\"})",
          "legendFormat": "CPU {{pod_name}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "count(up{job=\"dss-api\"} == 1) or vector(0)",
          "legendFormat": "Pods"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pods"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sécurité : échecs d'authentification et refus 429 / minute",
      "description": "Brute force = échecs d'authentification ; extraction du modèle = réponses 429 pour un client",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (reason) (rate(dss_auth_failures_total{job=\"dss-api\"}[2m])) * 60",
          "legendFormat": "401 {{reason}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (client) (rate(dss_rate_limited_total{job=\"dss-api\"}[2m])) * 60",
          "legendFormat": "429 {{client}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
