{
  "uid": "dss-api",
  "title": "Digital Social Score : API de toxicité",
  "tags": [
    "dss",
    "gmp"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Vue d'ensemble (indicateurs du cours : débit, latence P95, erreurs, pods)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes / seconde",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latence P95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erreurs 5xx",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\",status=\"5xx\"}[2m])) / sum(rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m])) or vector(0)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pods qui répondent",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "count(up{job=\"dss-api\"} == 1) or vector(0)",
          "legendFormat": "pods"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Trafic et latence",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requêtes / seconde par code de réponse",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (status) (rate(http_requests_total{job=\"dss-api\",handler=\"/score\"}[2m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latence HTTP de /score (P50, P95, P99)",
      "description": "Mesurée dans le pod (sans le trajet internet). Ligne rouge : seuil d'alerte de 500 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\"}[2m])))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "SLO : part des requêtes /score en moins de 300 ms",
      "description": "Objectif : au moins 95 % (règle du cours n°3, diapo 25).",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"dss-api\",handler=\"/score\",le=\"0.3\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"dss-api\",handler=\"/score\"}[5m]))",
          "legendFormat": "< 300 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latence de l'inférence seule (P50, P95)",
      "description": "Anonymisation spaCy + nettoyage + LSTM, sans la file d'attente HTTP (instrumentation manuelle, diapo 21).",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(dss_inference_latency_seconds_bucket{job=\"dss-api\"}[2m])))",
          "legendFormat": "P50 {{model}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(dss_inference_latency_seconds_bucket{job=\"dss-api\"}[2m])))",
          "legendFormat": "P95 {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Ressources (Cloud Monitoring, lues par PromQL)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU utilisé / CPU demandé, par pod",
      "description": "Le HPA ajoute des pods au-delà de 70 %. Alerte au-delà de 90 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "max by (pod_name) (kubernetes_io:container_cpu_request_utilization{monitored_resource=\"k8s_container\",namespace_name=\"default\",container_name=\"api\"})",
          "legendFormat": "{{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Mémoire utilisée / mémoire demandée, par pod",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (pod_name) (kubernetes_io:container_memory_request_utilization{monitored_resource=\"k8s_container\",namespace_name=\"default\",container_name=\"api\",memory_type=\"non-evictable\"})",
          "legendFormat": "{{pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Modèle et sécurité",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Part des textes jugés toxiques (score > 50)",
      "description": "Un changement brutal peut signaler une dérive des données ou une campagne de spam.",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "1 - sum(rate(dss_toxicity_score_bucket{job=\"dss-api\",le=\"50.0\"}[5m])) / sum(rate(dss_toxicity_score_count{job=\"dss-api\"}[5m]))",
          "legendFormat": "toxiques"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Échecs d'authentification / minute",
      "description": "Pic = essai de clés (brute force). Alerte au-delà de 20 par minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (reason) (rate(dss_auth_failures_total{job=\"dss-api\"}[2m])) * 60",
          "legendFormat": "clé {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Requêtes refusées par la limite (429) / minute",
      "description": "Un client qui dépasse 600 requêtes/minute : abus ou tentative de vol du modèle.",
      "datasource": {
        "type": "prometheus",
        "uid": "gmp"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gmp"
          },
          "expr": "sum by (client) (rate(dss_rate_limited_total{job=\"dss-api\"}[2m])) * 60",
          "legendFormat": "{{client}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
