# Fichiers envoyés à Cloud Build (gcloud builds submit).
# Sans ce fichier, gcloud reprendrait le .gitignore et oublierait les poids du modèle.
.git
.venv
venv
data/
docs/
reports/
**/__pycache__/
models/

# secrets locaux, jamais envoyés à Cloud Build
.env

# outils de déploiement et de test : inutiles dans l'image
deploy/
k8s/
monitoring/
loadtest/
.vscode/
.claude/
Makefile
