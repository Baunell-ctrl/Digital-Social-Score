# Paramètres du déploiement sur Google Cloud, lus par tous les scripts de deploy/.
# Aucun secret ici (clés et mots de passe sont dans Secret Manager) : ce fichier est versionné.
# Chaque valeur peut être remplacée au lancement :   TAG=v7 make deploy   ou   TAG=v7 bash deploy/deploy.sh

PROJECT=${PROJECT:-}                 # vide = projet actif de gcloud (gcloud config get-value project)
REGION=${REGION:-europe-west9}       # Paris : données en France (RGPD)
CLUSTER=${CLUSTER:-dss-cluster}      # cluster GKE Autopilot
REPO=${REPO:-dss}                    # dépôt Artifact Registry
TAG=${TAG:-v6}                       # version de l'image à construire / déployer
EMAIL=${EMAIL:-}                     # adresse qui reçoit les alertes (deploy/monitoring.sh)
